# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real keys.

# --- LLM Provider ---
# Which provider drives Tier-2 reasoning: "gemini" or "anthropic"
LLM_PROVIDER=gemini

# --- API Keys ---
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# --- Logging ---
# DEBUG enables per-field scoring traces; INFO is default
LOG_LEVEL=INFO

# --- Scoring Thresholds (optional overrides) ---
# TIER2_LOWER_BOUND=0.50
# TIER2_UPPER_BOUND=0.89
# GREEN_THRESHOLD=0.90
# AMBER_REVIEW_LOWER=0.70
# HARD_REJECT_PENALTY=100.0
# AGE_HARD_REJECT_DELTA=5
# AGE_FULL_SCORE_DELTA=3
