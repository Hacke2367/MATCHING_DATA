LLM_PROVIDER=gemini

# ── Gemini API ────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_api_key_here

# Extraction model (Layer 1 — high volume, structured JSON output).
# Paid tier recommendation: gemini-2.5-flash (fast, cheap, great at schema output).
GEMINI_MODEL=gemini-2.5-flash

# Reasoning model (Tier-2 LLM judge — low volume, deep adjudication).
# Paid tier recommendation: gemini-2.5-pro (best reasoning quality).
GEMINI_REASONING_MODEL=gemini-2.5-pro

# Maximum simultaneous in-flight API calls across all threads.
# Raise for higher-quota paid plans; lower if hitting 429s.
GEMINI_MAX_CONCURRENCY=8

# Minimum seconds between any two LLM calls (rate-limit guard).
# Paid plan:  0  (no throttle — quota handled by semaphore above).
# Free tier: 4.0 for gemini-2.5-flash (15 RPM free limit).
GEMINI_MIN_CALL_INTERVAL_SECS=0

# ── Anthropic (optional, not used by the engine) ──────────────────────────────
ANTHROPIC_API_KEY=

LOG_LEVEL=INFO

# ── Scoring Thresholds (optional overrides) ───────────────────────────────────
# TIER2_LOWER_BOUND=0.50
# TIER2_UPPER_BOUND=0.89
# GREEN_THRESHOLD=0.90
# AMBER_REVIEW_LOWER=0.70
# HARD_REJECT_PENALTY=100.0
# AGE_HARD_REJECT_DELTA=5
# AGE_FULL_SCORE_DELTA=3
